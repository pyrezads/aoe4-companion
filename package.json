{
  "name": "aoe4-coach",
  "productName": "AoE4 Coach",
  "version": "0.1.0",
  "description": "Build order coach and live analyst for Age of Empires IV. Reads your screen only.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "43.7.7",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.pyrezads.aoe4coach",
    "productName": "AoE4 Coach",
    "files": [
      "electron/**",
      "app/**",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
