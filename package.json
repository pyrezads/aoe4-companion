{
  "name": "aoe4-coach",
  "productName": "AoE4 Coach",
  "version": "0.1.4",
  "description": "Build order coach and live analyst for Age of Empires IV. Reads your screen only.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "dist:win": "electron-builder --win nsis",
    "build:core": "python -m PyInstaller packaging/aoe4-core.spec --distpath dist-core --workpath build-core --noconfirm"
  },
  "devDependencies": {
    "electron": "43.7.7",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.pyrezads.aoe4coach",
    "productName": "AoE4 Coach",
    "files": [
      "electron/**",
      "app/**",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "AoE4-Coach-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "AoE4 Coach"
    },
    "extraResources": [
      {
        "from": "dist-core/aoe4-core",
        "to": "core",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "pyrezads",
        "repo": "aoe4-companion",
        "releaseType": "release"
      }
    ],
    "npmRebuild": false
  },
  "dependencies": {
    "electron-log": "5.4.4",
    "electron-overlay-window": "4.1.0",
    "electron-updater": "6.8.10"
  }
}
